# Copia este archivo a .env y completa los valores. NO subas .env a Git.
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://postgres:Admin123@127.0.0.1:5433/rorigenes# Secreto para firmar los JWT (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET= node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Usuario administrador inicial (la contraseña debe tener al menos 12 caracteres)
ADMIN_EMAIL=admin@origenes.local
ADMIN_PASSWORD=OrigenesAdmin2026!
